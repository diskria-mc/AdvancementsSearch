{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${modVersion}",
	"name": "${modName}",
	"description": "A client-side mod that adds a search feature to the advancements window.",
	"authors": [
		"${author}"
	],
	"contact": {
		"sources": "${repoUrl}"
	},
	"license": "MIT",
	"icon": "assets/advancements_search/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
          "io.github.diskria.advancements_search.AdvancementsSearchMod"
		]
	},
	"mixins": [
		"advancements_search.mixins.json"
	],
	"depends": {
		"java": ">=${minJavaVersion}",
		"minecraft": ">=${minMinecraftVersion}",
		"fabricloader": ">=${minLoaderVersion}"
	},
	"accessWidener": "advancements_search.accesswidener"
}
